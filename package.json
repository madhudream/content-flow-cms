{
  "name": "contentflow-cms",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:deploy": "node scripts/build-for-deploy.js",
    "dev": "turbo run dev",
    "dev:server": "bun --cwd apps/server run dev",
    "start:server": "bun --cwd apps/server run start",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "infra:install": "cd pulumi && npm install",
    "infra:preview": "cd pulumi && pulumi preview",
    "infra:up": "cd pulumi && pulumi up",
    "infra:destroy": "cd pulumi && pulumi destroy",
    "infra:stack": "cd pulumi && pulumi stack",
    "infra:config": "cd pulumi && pulumi config",
    "deploy": "npm run build:deploy && npm run infra:up"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.7.4",
    "turbo": "^2.8.12",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@types/d3": "^7.4.3",
    "@types/topojson-client": "^3.1.5",
    "d3": "^7.9.0",
    "topojson-client": "^3.1.0"
  }
}
