# Server Configuration
NODE_ENV=development
PORT=8080

# Storage Configuration
STORAGE_TYPE=local

# Local Storage (Development)
LOCAL_CONTENT_DIR=../../data
LOCAL_IMAGES_DIR=../../data/images

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# Azure Configuration (for production deployment)
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_CLIENT_ID=your-client-id
AZURE_SERVICE_PRINCIPAL_DISPLAY_NAME=contentflow-cms-sp
PULUMI_ACCESS_TOKEN=your-pulumi-token

# OpenAI Translation Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Note: Use gpt-4o-mini or gpt-5.1. Avoid gpt-5-nano as it doesn't support temperature parameter
OPENAI_TEMPERATURE=0.3
